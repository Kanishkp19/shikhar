# ──────────────────────────────────────────────────────────────
# Shikhar — environment variables
# Copy this file to `.env.local` and fill in the real values.
# `.env.local` is gitignored — never commit real secrets.
# ──────────────────────────────────────────────────────────────

# Supabase (https://app.supabase.com/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # server-only — cron routes, bypasses RLS

# Auth — single allowlisted email (only this user can access the app)
ALLOWED_USER_EMAIL=kanishk@example.com

# LLM — OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-...

# LLM — Google AI Studio Gemini (https://aistudio.google.com/apikey) — free tier, 65k output tokens
GEMINI_API_KEY=AIza...

# LLM — Groq (https://console.groq.com/keys)
GROQ_API_KEY=gsk_...

# Web Push — VAPID keys (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:kanishk@example.com

# Cron — random 32-char secret; verify Supabase Edge Function → Next.js API calls
# Generate with: openssl rand -hex 32
CRON_SECRET=
